# Copy to .env and fill in. Every key is optional — the server boots without
# any of them and reports which features are disabled at /health.

PORT=8080
LOG_LEVEL=info
DATABASE_PATH=./data/trippo.db

# --- Planner + link extraction (Google Gemini) ---
# Free key: https://aistudio.google.com/apikey
# Without this, POST /trips/:id/plan and all link imports return 503.
#
# Note: on Google's FREE tier, submitted content is used to improve their
# products — that includes trip details and anything users paste in. The paid
# tier does not. Consider that before real users touch this.
GEMINI_API_KEY=
PLANNER_MODEL=gemini-3.7-flash
# minimal | low | medium | high — raise for complex multi-city trips.
PLANNER_EFFORT=high
# Pulling places out of a page is mechanical, so it runs on a cheaper model.
EXTRACTION_MODEL=gemini-3.5-flash-lite

# --- Geocoding and transit ---
# osm    = Photon (geocoding) + Transitous/MOTIS (transit). Free, no key,
#          no quota. This is the default and needs nothing set below.
# google = Places (New) + Routes API. Better place ranking and transit
#          coverage, but needs a key and bills per call.
#
# Proximity clustering ("which places share a day") is geometric either way
# and calls no API at all.
MAPS_PROVIDER=osm

# Only read when MAPS_PROVIDER=google.
GOOGLE_MAPS_API_KEY=

# Point these at your own instances to stop depending on the public ones.
# Both are open source and self-hostable.
PHOTON_URL=https://photon.komoot.io
MOTIS_URL=https://api.transitous.org

# --- Flights ---
# mock    = synthetic offers, no credentials, always flagged as estimates
# amadeus = Amadeus Self-Service; requires the two keys below
FLIGHT_PROVIDER=mock
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test.api.amadeus.com returns cached, non-bookable inventory. Offers from it
# are marked is_estimate=true. Switch to api.amadeus.com for production.
AMADEUS_BASE_URL=https://test.api.amadeus.com
