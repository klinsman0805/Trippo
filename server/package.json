{
  "name": "trippo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "DATABASE_PATH=memory:// GEMINI_API_KEY= node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@google/genai": "^2.17.1",
    "@mozilla/readability": "^0.5.0",
    "fastify": "^5.1.0",
    "jose": "^6.2.12",
    "jsdom": "^25.0.1",
    "postgres": "^3.4.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
