<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Cleartext HTTP is off by default from API 28, which would block the
         local dev server at http://10.0.2.2:8080 or http://<host>:8080.
         Debug-only on purpose: release builds keep the secure default, so
         this cannot quietly ship. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
